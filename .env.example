# --- Server ---
PORT=3000
# Public origin users open in the browser. Dev: the Vite URL. Docker: http://localhost:3000
# Used for OAuth redirect URIs ({APP_URL}/auth/<provider>/callback) and the WebSocket Origin check.
APP_URL=http://localhost:5173
# Relative sqlite paths resolve against backend/prisma/
DATABASE_URL=file:./dev.db
# Random string, >= 16 chars (used to HMAC session tokens). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- SSO (leave a provider blank to disable it) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Notifications ---
# Default interval (seconds) for periodic overdue / due-soon batches (10..3600)
NOTIFY_INTERVAL_SEC=60
